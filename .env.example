# Copiar este archivo como ".env" y ajustar los valores si es necesario.
# No se commitea ningun ".env" real; ver .gitignore.

DATABASE_NAME=franchise_db
DATABASE_USERNAME=franchise_user
DATABASE_PASSWORD=franchise_pass

# Puerto expuesto al host para Postgres en docker-compose (no afecta la
# comunicacion interna API -> DB). Cambiar si el 5433 tambien esta ocupado.
DB_HOST_PORT=5433

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
